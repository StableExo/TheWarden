# =============================================================================
# TheWarden - Governed Execution Wedge
# Base Mainnet arbitrage + the Supabase nervous system. Nothing else.
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# --- Supabase nervous system -------------------------------------------------
# Use the SERVICE ROLE key: it is the only role allowed to write to
# execution_queue, guardrail_policies and cognitive_ledger.
SUPABASE_URL=https://pxbjuhtnmvfywbwmdkdr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Base Mainnet ------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
WALLET_ADDRESS=0xYourWalletAddress
PRIVATE_KEY=0xYourPrivateKey

# --- FlashSwap V3 executor ---------------------------------------------------
FLASHSWAP_V3_ADDRESS=0xYourFlashSwapV3Address

# --- Governance --------------------------------------------------------------
# Keep this TRUE until you have watched simulations in execution_queue and they
# look right. Only flip it to false once you trust the guardrails.
DRY_RUN=true
