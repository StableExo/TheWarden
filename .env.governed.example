# =============================================================================
# TheWarden - Governed Execution Wedge
# Base Mainnet arbitrage + the Supabase nervous system. Nothing else.
#
# Key names are the ones src/main.ts actually reads. Copy to .env and fill in.
# NEVER commit the real .env.
# =============================================================================

# --- Supabase nervous system -------------------------------------------------
# Writes to execution_queue / guardrail_policies / cognitive_ledger need the
# service role key. SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Base Mainnet ------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# --- Wallet ------------------------------------------------------------------
# main.ts reads WALLET_PRIVATE_KEY, or DEPLOYER_PRIVATE_KEY as a fallback.
WALLET_PRIVATE_KEY=0xYourPrivateKey

# --- FlashSwap V3 executor ---------------------------------------------------
FLASHSWAP_V3_ADDRESS=0xYourFlashSwapV3Address
ENABLE_FLASHSWAP_V3=true
# Needed for the V3 smart-wallet (UserOp) path; without it initV3Executor warns.
CDP_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/<key>

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production

# --- Live vs simulate --------------------------------------------------------
# This flag decides whether src/main.ts boots IntegratedArbitrageOrchestrator at
# all: line 631 only constructs it when dryRun is false. Set false here so the
# governed path runs, and let guardrail_policies decide live vs simulate.
# The seeded global DRY_RUN policy (priority 1, action deny) keeps every
# opportunity on simulateArbitrage() until you change that policy.
DRY_RUN=false
